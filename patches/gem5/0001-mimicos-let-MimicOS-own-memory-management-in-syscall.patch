+         * Carve MimicOS's space out of the pool up front so its frames
+         * cannot collide with the ones gem5 hands out for descriptor
+         * tables and GPU buffers, which still come from the pool.
+         */
+        const uint64_t frames = mimicos->numFrames();
+        const Addr free_bytes = memPools.freeMemSize();
+        const Addr needed = frames * 4096ull;
