+            MimicOSBroker::instance().enable(base, mimicosKernelPid);
+            inform("MimicOS runs in the guest; the kernel decides placement");
+        }
+        inform("MimicOS reserved %llu MiB of physical memory at %#llx",
+               (unsigned long long)(needed >> 20), (unsigned long long)base);
+    }
+}
+
+Addr
+SEWorkload::mimicosAllocPage(Addr vaddr, uint32_t asid, unsigned *log_bytes)
+{
+    /*
+     * With a kernel in the guest, the frame was decided by MimicOS
+     * running as a real process; this just picks up its answer.  The
+     * region checks in MemState still ran on the way here.
+     */
+    Addr from_kernel = 0;
+    unsigned kernel_bytes = 12;
+    if (MimicOSBroker::instance().takeAnswer(asid, vaddr, &from_kernel,
+                                             &kernel_bytes)) {
+        if (log_bytes != nullptr)
+            *log_bytes = kernel_bytes;
+        return from_kernel;
+    }
+
+    if (mimicosInGuest) {
+        /*
+         * No answer waiting, so this is not the application's fault: it
+         * is the kernel process itself, or a page set up before the
+         * kernel was running.  Those come from gem5's pool.  Serving
+         * them from the copy of MimicOS in here would put two
+         * allocators on the same physical region, and they would hand
+         * out the same frames.
+         */
+        if (log_bytes != nullptr)
+            *log_bytes = 12;
+        return allocPhysPages(1);
+    }
+
+    assert(mimicos);
+    Addr paddr = 0;
+    fatal_if(!mimicos->allocate(vaddr, asid, &paddr, log_bytes),
+             "MimicOS could not back virtual address %#llx (out of physical "
+             "memory?)", (unsigned long long)vaddr);
+    return paddr;
+}
+
+uint64_t
+SEWorkload::takeMimicosFaultLatencyNs()
+{
+    return mimicos ? mimicos->takePendingLatencyNs() : 0;
 }
 
