+# DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+# THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+# (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+# OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+
+"""Syscall-emulation mode with MimicOS backing process memory.
+
+Stock SE mode allocates physical frames with a bump pointer and resolves minor
+faults in zero simulated time, so neither physical placement nor fault cost is
+modelled. Pointing the workload at a MimicOS config replaces both: frames come
+from MimicOS's buddy/THP allocator, and each minor fault carries MimicOS's
+calibrated cost.
+
+Run it with and without --mimicos-config to see the difference:
+
+    build/X86/gem5.opt configs/example/mimicos_se.py
+    build/X86/gem5.opt configs/example/mimicos_se.py \
+        --mimicos-config ../../mimicos/configs/embedded_4gb_thp.ini
+
+Requires a gem5 built with MIMICOS_HOME set; see src/sim/mimicos_binding.hh.
+"""
+
+import argparse
+import os
+
+import m5
+from m5.objects import *
+
+thispath = os.path.dirname(os.path.realpath(__file__))
+default_binary = os.path.join(
+    thispath, "..", "..", "tests/test-progs/hello/bin/x86/linux/hello"
+)
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument(
+    "binary", nargs="?", default=default_binary, help="binary to run"
+)
+parser.add_argument(
+    "--options", default="", help="arguments to pass to the binary"
+)
+parser.add_argument(
+    "--mimicos-config",
+    default="",
+    help="path to a MimicOS INI. Empty (the default) uses stock SE-mode "
+    "allocation, which makes this script a plain baseline.",
+)
+parser.add_argument(
+    "--mem-size",
+    default="8GiB",
+    help="physical memory size. Must be larger than the MimicOS config's "
+    "[pmem_alloc] memory_size, since MimicOS reserves that much up front.",
+)
+parser.add_argument(
+    "--cpu-type",
+    default="timing",
+    choices=["atomic", "timing"],
+    help="atomic is faster; timing is needed for the fault stall to show up "
+    "in the cycle count",
+)
+parser.add_argument(
+    "--mimicos-server",
+    default="",
+    help="path to mimicos_gem5_server. When given, MimicOS runs as a second "
+    "process on its own CPU and handles each fault with its own "
+    "instructions, instead of the simulator calling into it.",
+)
+parser.add_argument(
+    "--app-threads",
+    type=int,
+    default=1,
+    help="CPUs available to the application, counting the main thread. "
+    "Syscall emulation gives a new thread the first idle context it "
+    "finds, so this must be at least one more than the number of "
+    "threads created, or pthread_create returns EAGAIN and that "
+    "thread's work is silently missing from the result. The kernel "
+    "always gets a further CPU of its own.",
+)
+parser.add_argument(
+    "--max-instructions",
+    type=int,
+    default=0,
+    help="stop after this many instructions (0 = run to completion)",
+)
+args = parser.parse_args()
+
+system = System()
+
+system.clk_domain = SrcClockDomain()
+system.clk_domain.clock = "3GHz"
+system.clk_domain.voltage_domain = VoltageDomain()
+
+system.mem_mode = "atomic" if args.cpu_type == "atomic" else "timing"
+system.mem_ranges = [AddrRange(args.mem_size)]
+
+# The kernel needs a CPU of its own: it has to run while a faulting
+# thread is parked.  Application threads need one each, since a parked
+# thread cannot lend its context to another.
+num_cpus = args.app_threads + (1 if args.mimicos_server else 0)
+
+if args.cpu_type == "atomic":
+    system.cpu = [X86AtomicSimpleCPU(cpu_id=i) for i in range(num_cpus)]
+else:
+    system.cpu = [X86TimingSimpleCPU(cpu_id=i) for i in range(num_cpus)]
+
+system.membus = SystemXBar()
+
+for cpu in system.cpu:
+    cpu.icache_port = system.membus.cpu_side_ports
+    cpu.dcache_port = system.membus.cpu_side_ports
+    cpu.createInterruptController()
+    cpu.interrupts[0].pio = system.membus.mem_side_ports
+    cpu.interrupts[0].int_requestor = system.membus.cpu_side_ports
+    cpu.interrupts[0].int_responder = system.membus.mem_side_ports
+
+system.system_port = system.membus.cpu_side_ports
+
+system.mem_ctrl = MemCtrl()
+system.mem_ctrl.dram = DDR3_1600_8x8()
+system.mem_ctrl.dram.range = system.mem_ranges[0]
+system.mem_ctrl.port = system.membus.mem_side_ports
+
+system.workload = SEWorkload.init_compatible(args.binary)
+
+# This is the whole integration on the configuration side: hand the workload a
+# MimicOS config and it stops using gem5's MemPool for process memory.
+if args.mimicos_config:
+    config_path = os.path.abspath(args.mimicos_config)
+    if not os.path.exists(config_path):
+        raise SystemExit(f"MimicOS config not found: {config_path}")
+    system.workload.mimicos_config = config_path
+
+# @kanellok: --mimicos-server puts MimicOS in the guest.  The kernel
+# gets a CPU of its own, because it has to run while the faulting thread
+# is parked.
+if args.mimicos_server:
+    if not args.mimicos_config:
+        raise SystemExit("--mimicos-server needs --mimicos-config")
+    server_path = os.path.abspath(args.mimicos_server)
+    if not os.path.exists(server_path):
+        raise SystemExit(f"MimicOS server not found: {server_path}")
+    system.workload.mimicos_in_guest = True
+    system.workload.mimicos_kernel_pid = 101
+
+app = Process(pid=100)
+app.cmd = [args.binary] + args.options.split()
+
+# Every CPU the application may use gets the same process.  That is how
+# syscall emulation gives a thread somewhere to run: clone hands a new
+# thread the first context that is idle.
+for i in range(args.app_threads):
+    system.cpu[i].workload = app
+    system.cpu[i].createThreads()
+
+if args.mimicos_server:
+    # Last CPU, so the application's threads land on the ones before it.
+    kernel = Process(pid=101)
+    kernel.cmd = [os.path.abspath(args.mimicos_server), config_path]
+    system.cpu[num_cpus - 1].workload = kernel
+    system.cpu[num_cpus - 1].createThreads()
+
+if args.max_instructions > 0:
+    system.cpu[0].max_insts_any_thread = args.max_instructions
+
+root = Root(full_system=False, system=system)
+m5.instantiate()
+
+print(f"Beginning simulation of {args.binary}")
+if args.mimicos_server:
+    print(f"MimicOS: in the guest, {args.mimicos_server}")
+elif args.mimicos_config:
+    print(f"MimicOS config: {args.mimicos_config}")
+else:
+    print("MimicOS: disabled (stock SE-mode allocation)")
+
+exit_event = m5.simulate()
+print(
+    f"Exiting @ tick {m5.curTick()} because {exit_event.getCause()}"
+)
diff --git a/include/gem5/asm/generic/m5ops.h b/include/gem5/asm/generic/m5ops.h
index 9bd10e0..1280eab 100644
--- a/include/gem5/asm/generic/m5ops.h
+++ b/include/gem5/asm/generic/m5ops.h
@@ -80,6 +80,19 @@
 
 #define M5OP_WORKLOAD           0x70
 
+/*
+ * @kanellok: the three instructions the guest kernel uses to talk to
+ * the simulator.  wait blocks until there is a fault, asid says which
+ * address space it came from, reply hands back the frame.
+ *
+ * Hand a page fault to a MimicOS kernel running as a guest process.
+ * wait blocks until a fault is pending and returns its virtual address;
+ * reply says which frame backs it and how big the page is.
+ */
+#define M5OP_MIMICOS_WAIT       0x71
+#define M5OP_MIMICOS_REPLY      0x72
+#define M5OP_MIMICOS_ASID       0x73
+
 
 #define M5OP_FOREACH                                            \
     M5OP(m5_arm, M5OP_ARM)                                      \
@@ -107,7 +120,10 @@
     M5OP(m5_work_begin, M5OP_WORK_BEGIN)                        \
     M5OP(m5_work_end, M5OP_WORK_END)                            \
     M5OP(m5_dist_toggle_sync, M5OP_DIST_TOGGLE_SYNC)            \
-    M5OP(m5_workload, M5OP_WORKLOAD)                            \
+    M5OP(m5_workload, M5OP_WORKLOAD)                             \
+    M5OP(m5_mimicos_wait, M5OP_MIMICOS_WAIT)                    \
+    M5OP(m5_mimicos_reply, M5OP_MIMICOS_REPLY)                  \
+    M5OP(m5_mimicos_asid, M5OP_MIMICOS_ASID)                    \
 
 #define M5OP_MERGE_TOKENS_I(a, b) a##b
 #define M5OP_MERGE_TOKENS(a, b) M5OP_MERGE_TOKENS_I(a, b)
diff --git a/src/SConscript b/src/SConscript
index 52051b3..85da001 100644
--- a/src/SConscript
+++ b/src/SConscript
@@ -61,6 +61,39 @@ Import('*')
 if env['CONF']['USE_EFENCE']:
     env.Append(LIBS=['efence'])
 
+# @kanellok: MimicOS integration (opt-in).
+#
+#   MIMICOS_HOME=/path/to/virtuoso_artifact/mimicos scons build/X86/gem5.opt
+#
+# When MIMICOS_HOME is set, SE mode can hand physical allocation and the
+# minor-fault cost model to MimicOS -- see src/sim/mimicos_binding.hh.  Without
+# it, src/sim/mimicos_binding.cc compiles to stubs, nothing links against
+# MimicOS, and gem5 is unchanged.  MIMICOS_SNIPER_INCLUDE points at the shared
+# allocator headers and defaults to the layout of the Virtuoso artifact
+# repository.
+mimicos_home = os.environ.get('MIMICOS_HOME')
+if mimicos_home:
+    mimicos_home = os.path.abspath(mimicos_home)
+    mimicos_lib = os.environ.get(
+        'MIMICOS_LIB', os.path.join(mimicos_home, 'build', 'libmimicos.a'))
+    mimicos_sniper_include = os.environ.get(
+        'MIMICOS_SNIPER_INCLUDE',
+        os.path.join(mimicos_home, os.pardir, 'simulator', 'sniper', 'include'))
+
+    if not os.path.exists(mimicos_lib):
+        error("MIMICOS_HOME is set but %s does not exist. Build it first with "
+              "'make -C %s lib-static'." % (mimicos_lib, mimicos_home))
+
+    env.Append(CPPDEFINES=['GEM5_USE_MIMICOS'])
+    env.Append(CPPPATH=[
+        Dir(os.path.join(mimicos_home, 'include')),
+        Dir(os.path.abspath(mimicos_sniper_include)),
+    ])
+    # Appended to LIBS as a File so SCons treats a rebuilt libmimicos.a as a
+    # dependency and relinks, rather than leaving a stale copy in place.
+    env.Append(LIBS=[File(mimicos_lib)])
+    print("Building with MimicOS support from %s" % mimicos_home)
+
 # Children need to see the environment
 Export('env')
 
