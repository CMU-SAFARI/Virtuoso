+            if (fault_ns > 0) {
+                DPRINTF(Faults, "Charging %llu ns for the minor fault at "
+                        "%#x.\n", (unsigned long long)fault_ns, addr);
+                tc->quiesceTick(curTick() + sim_clock::as_int::ns * fault_ns);
+            }
+        }
+    } else {
         PageFaultErrorCode code = errorCode;
         const char *modeStr = "";
         if (code.fetch)
