+    /*
+     * @kanellok: a page fault with a MimicOS kernel in the guest.
+     *
+     * Park this thread and let the kernel run.  It answers, we wake up,
+     * the instruction runs again, faults again, and the second time the
+     * answer is waiting and the normal path below uses it.  Two faults
+     * per miss, which is the price of doing it honestly.
+     */
+    } else if (MimicOSBroker::instance().handOff(tc, addr)) {
+        /*
+         * A MimicOS kernel in the guest is working out which frame backs
+         * this address.  The thread is parked; when it runs again it
+         * re-executes this instruction, faults once more, and the second
+         * time round the answer is waiting and the normal path uses it.
+         */
+        DPRINTF(Faults, "Handed the fault at %#x to the MimicOS kernel.\n",
+                addr);
+    } else if (tc->getProcessPtr()->fixupFault(addr)) {
+        /*
+         * SE mode resolves a minor fault in zero simulated time.  When
