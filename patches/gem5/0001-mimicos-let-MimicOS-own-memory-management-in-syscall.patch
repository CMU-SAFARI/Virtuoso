+++ b/src/arch/x86/tlb.cc
@@ -126,8 +126,13 @@ TLB::insert(Addr vpn, const TlbEntry &entry, uint64_t pcid)
         trie.insert(vpn, TlbEntryTrie::MaxBits-entry.logBytes, newEntry);
     }
     else {
+        /*
+         * SE mode used to force full width here, which pinned every
+         * entry to 4K.  Use the entry's own size so large pages cover
+         * their whole range with one entry.
+         */
