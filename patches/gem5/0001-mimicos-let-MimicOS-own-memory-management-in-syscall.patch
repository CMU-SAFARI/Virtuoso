+        const Addr base = memPools.allocPhysPages((int)frames);
+        mimicos->setPhysBase(base);
+        /*
+         * @kanellok: with the kernel in the guest, gem5's own copy of
+         * MimicOS steps aside.  It has already reserved the physical
+         * range; from here on the guest decides what goes where.
+         */
+        if (mimicosInGuest) {
+            /*
+             * The kernel decides the frames, so the copy of MimicOS in
+             * here is only used for the reservation and the geometry.
