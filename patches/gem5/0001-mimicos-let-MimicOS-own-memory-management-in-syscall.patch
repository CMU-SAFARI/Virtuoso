+"""Tests for the MimicOS syscall-emulation hook.
+
+The two tests here run with MimicOS *disabled*, and that is deliberate: they
+are the regression guard, checking that the code paths added for MimicOS leave
+stock SE mode behaving exactly as before. They run in any build, including one
+without MIMICOS_HOME set.
+
+Exercising MimicOS itself needs a library build and a MimicOS INI, neither of
+which a stock gem5 checkout has. That side is covered by
+mimicos/tests/check_gem5_se.py in the Virtuoso artifact, which runs gem5 twice
+and compares.
+"""
+
+from testlib import *
+
+config_path = joinpath(config.base_dir, "configs", "example")
+
+# Plain SE mode through the MimicOS example config, with MimicOS off. Proves
+# the hook in Process::allocateMem and the SEWorkload parameter do not disturb
+# the stock allocation path.
+gem5_verify_config(
+    name="mimicos_se_disabled",
+    verifiers=(),
+    config=joinpath(config_path, "mimicos_se.py"),
+    config_args=["--cpu-type", "atomic"],
+    length=constants.quick_tag,
+    valid_isas=(constants.x86_tag, constants.all_compiled_tag),
+)
+
+# The same thing in timing mode, which is the mode where a charged fault
+# latency would show up in the tick count.
+gem5_verify_config(
+    name="mimicos_se_disabled_timing",
+    verifiers=(),
+    config=joinpath(config_path, "mimicos_se.py"),
+    config_args=["--cpu-type", "timing"],
+    length=constants.quick_tag,
+    valid_isas=(constants.x86_tag, constants.all_compiled_tag),
+)
