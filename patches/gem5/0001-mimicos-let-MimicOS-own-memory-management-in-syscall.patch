+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "sim/mimicos_binding.hh"
+
+#include <cstdlib>
+#include <sstream>
+
+#include "base/logging.hh"
+
+namespace gem5
+{
+
+#ifdef GEM5_USE_MIMICOS
+
+} // namespace gem5
+
+#include "mimicos_embed.h"
+
+namespace gem5
+{
+
+namespace
+{
+constexpr uint64_t PageShift4K = 12;
+} // namespace
+
+struct MimicOSBinding::Impl
+{
+    std::unique_ptr<mimicos::Kernel> kernel;
+    uint64_t frames = 0;
+    Addr phys_base = 0;
+    bool phys_base_set = false;
+    uint64_t pending_latency_ns = 0;
+};
+
+bool MimicOSBinding::available() { return true; }
+
+MimicOSBinding::MimicOSBinding() : impl(new Impl()) {}
+MimicOSBinding::~MimicOSBinding()
+{
+    if (impl && impl->kernel)
+        impl->kernel->flush_mapping_trace();
+}
+
+std::unique_ptr<MimicOSBinding>
+MimicOSBinding::attach(const std::string &ini_path, std::string *err)
+{
+    mimicos::KernelConfig cfg;
+    if (!mimicos::KernelConfig::from_ini(ini_path, &cfg, err))
+        return nullptr;
+
+    /*
+     * No page table walker in SE mode, so the depth is not observable.
+     * Keep what the config says; it only changes how many page table
+     * frames MimicOS charges to the kernel reserve.
+     */
+    auto kernel = mimicos::Kernel::create(cfg, err);
+    if (kernel == nullptr)
+        return nullptr;
+
+    std::unique_ptr<MimicOSBinding> binding(new MimicOSBinding());
+    binding->impl->kernel = std::move(kernel);
+    /*
+     * Reserve the whole space, not just the data pool.  Page table
+     * frames come from the kernel reserve at the bottom and data frames
+     * from above, so the numbers returned span [0, memory_size).
+     * Reserving less leaves the top overlapping frames gem5 hands out.
+     */
+    binding->impl->frames = cfg.memory_size_mb * 1024ull * 1024ull / 4096ull;
+
+    /* Log mapping decisions so a run can be replayed and compared. */
+    const char *trace_path = std::getenv("MIMICOS_MAPPING_TRACE");
+    if (trace_path != nullptr && trace_path[0] != '\0') {
+        std::string trace_err;
+        if (!binding->impl->kernel->enable_mapping_trace(trace_path,
+                                                         &trace_err)) {
+            if (err != nullptr)
+                *err = trace_err;
+            return nullptr;
+        }
+        inform("MimicOS mapping trace -> '%s'", trace_path);
+    }
+
+    return binding;
+}
+
+uint64_t MimicOSBinding::numFrames() const { return impl->frames; }
+
+void
+MimicOSBinding::setPhysBase(Addr base)
+{
+    impl->phys_base = base;
+    impl->phys_base_set = true;
+}
+
+Addr MimicOSBinding::physBase() const { return impl->phys_base; }
+
+bool
+MimicOSBinding::allocate(Addr vaddr, uint32_t asid, Addr *paddr,
+                         unsigned *log_bytes)
+{
+    /* Without a base, frame numbers would alias what the MemPool gave out. */
+    if (!impl->phys_base_set)
+        return false;
+
+    mimicos::FaultRequest req;
+    req.vaddr = vaddr;
+    req.asid = asid;
+    req.core_id = 0;
+    /*
+     * The access type does not reach us and the page table carries no
+     * mapping metadata, so every fault is an anonymous write.  The
+     * standalone kernel assumes the same without VMA information.
+     */
+    req.access = mimicos::AccessType::WRITE;
+    req.mapping = mimicos::MappingType::ANON;
+
+    const auto t = impl->kernel->translate(req);
+    if (!t.ok)
+        return false;
+
+    impl->pending_latency_ns += t.fault_latency_ns;
+
+    if (paddr != nullptr)
+        *paddr = impl->phys_base + (t.ppn << PageShift4K);
+    if (log_bytes != nullptr)
+        *log_bytes = t.page_size_bits;
+    return true;
+}
+
+uint64_t
+MimicOSBinding::takePendingLatencyNs()
+{
+    const uint64_t ns = impl->pending_latency_ns;
+    impl->pending_latency_ns = 0;
+    return ns;
+}
+
+std::string
+MimicOSBinding::summary() const
+{
+    const auto s = impl->kernel->stats();
+    std::ostringstream oss;
+    oss << "MimicOS: " << s.translations << " translations, " << s.minor_faults
+        << " minor faults (" << s.huge_page_faults << " huge), "
+        << s.data_frames_allocated << " data frames, " << s.pt_frames_allocated
+        << " page-table frames";
+    if (s.failed_allocations > 0)
+        oss << ", " << s.failed_allocations << " FAILED allocations";
+    if (s.aliased_frames > 0)
+        oss << ", " << s.aliased_frames << " ALIASED frames";
+    return oss.str();
+}
+
+#else /* !GEM5_USE_MIMICOS -- stubs, so a stock gem5 has no MimicOS dependency */
+
+struct MimicOSBinding::Impl
+{
+};
+
+bool MimicOSBinding::available() { return false; }
+
+MimicOSBinding::MimicOSBinding() : impl(nullptr) {}
+MimicOSBinding::~MimicOSBinding() = default;
+
+std::unique_ptr<MimicOSBinding>
+MimicOSBinding::attach(const std::string &ini_path, std::string *err)
+{
+    (void)ini_path;
+    if (err != nullptr) {
+        *err = "this gem5 was built without MimicOS support; rebuild with "
+               "MIMICOS_HOME=<path to mimicos> in the environment to enable it";
+    }
+    return nullptr;
+}
+
+uint64_t MimicOSBinding::numFrames() const { return 0; }
+void MimicOSBinding::setPhysBase(Addr base) { (void)base; }
+Addr MimicOSBinding::physBase() const { return 0; }
+bool MimicOSBinding::allocate(Addr, uint32_t, Addr *, unsigned *)
+{
+    return false;
+}
+uint64_t MimicOSBinding::takePendingLatencyNs() { return 0; }
+std::string MimicOSBinding::summary() const { return {}; }
+
+#endif
+
+} // namespace gem5
