         ReadOnly    = 8,
+        /*
+         * @kanellok: how big the real page is.
+         *
+         * The page table stores one entry per 4K page even when the
+         * underlying page is larger.  These flags record how big the
+         * real page is so the TLB can install a single entry for it
+         * instead of 512 or 262144 of them.
+         */
+        Huge2M      = 16,
+        Huge1G      = 32,
     };
 
+    /* log2 of the page size recorded in a mapping's flags. */
+    static unsigned
+    pageShiftFromFlags(uint64_t flags)
+    {
+        if (flags & Huge1G)
+            return 30;
+        if (flags & Huge2M)
+            return 21;
+        return 12;
+    }
+
     // flag which marks the page table as shared among software threads
     bool shared;
 
