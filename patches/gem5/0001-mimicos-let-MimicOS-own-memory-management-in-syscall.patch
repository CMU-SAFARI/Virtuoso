 }
@@ -449,13 +454,38 @@ TLB::translate(const RequestPtr &req,
                         return std::make_shared<PageFault>(vaddr, true, mode,
                                                            true, false);
                     } else {
-                        Addr alignedVaddr = p->pTable->pageAlign(vaddr);
-                        DPRINTF(TLB, "Mapping %#x to %#x\n", alignedVaddr,
-                                pte->paddr);
+                        /*
+                         * @kanellok: install one entry for the whole
+                         * page, however big it is.  Without this a 2M
+                         * page costs 512 entries and buys nothing.
+                         *
+                         * The page table keeps one entry per 4K page, but
+                         * the mapping flags say how big the real page is.
+                         * Install one TLB entry covering the whole page so
+                         * a 2M page costs one entry, not 512.
+                         */
+                        unsigned log_bytes =
+                            EmulationPageTable::pageShiftFromFlags(pte->flags);
+
+                        /*
+                         * concAddrPcid() packs the pcid into the low 12
+                         * bits and the trie only matches the top
+                         * 64 - log_bytes, so a large entry does not
+                         * distinguish address spaces.  Full system mode
+                         * has the same hole.  It does not bite in SE
+                         * mode because each CPU's TLB serves one
+                         * process, and gem5 gives every process its own
+                         * page table.
+                         */
+                        Addr alignedVaddr = vaddr & ~mask(log_bytes);
+                        Addr alignedPaddr = pte->paddr & ~mask(log_bytes);
+                        DPRINTF(TLB, "Mapping %#x to %#x, %u byte page\n",
+                                alignedVaddr, alignedPaddr, 1U << log_bytes);
                         entry = insert(alignedVaddr, TlbEntry(
-                                p->pTable->pid(), alignedVaddr, pte->paddr,
+                                p->pTable->pid(), alignedVaddr, alignedPaddr,
                                 pte->flags & EmulationPageTable::Uncacheable,
-                                pte->flags & EmulationPageTable::ReadOnly),
+                                pte->flags & EmulationPageTable::ReadOnly,
+                                log_bytes),
                                 pcid);
                     }
                     DPRINTF(TLB, "Miss was serviced.\n");
