+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#ifndef __SIM_MIMICOS_BINDING_HH__
+#define __SIM_MIMICOS_BINDING_HH__
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "base/types.hh"
+
+namespace gem5
+{
+
+/*
+ * @kanellok: gem5's own copy of MimicOS, used when the kernel is not
+ * running in the guest.  With --mimicos-server it only reserves the
+ * physical range; the guest kernel decides everything else.
+ *
+ * Bridge to the MimicOS library (mimicos/include/mimicos_embed.h).
+ *
+ * SE mode allocates frames with a bump pointer and resolves minor
+ * faults in zero simulated time.  Neither models anything: placement is
+ * whatever order pages were touched in, and a fault is free.  With this
+ * attached, placement comes from MimicOS's buddy/THP allocator and the
+ * fault carries its cost.
+ *
+ * This does not give SE mode a page table walker.  EmulationPageTable
+ * is a functional map with no memory traffic, so MimicOS's page tables
+ * are never read here.  ChampSim has a real walker; that is where page
+ * table geometry shows up.
+ *
+ * MimicOS allocates in its own physical space.  SEWorkload reserves
+ * that space from the MemPool up front and tells us the base, so its
+ * frames cannot collide with the ones gem5 hands out for descriptor
+ * tables and GPU buffers.
+ *
+ * Built without GEM5_USE_MIMICOS this is all stubs and attach() fails.
+ */
+class MimicOSBinding
+{
+  public:
+    /* Attach from an INI, the same file the standalone kernel takes. */
+    static std::unique_ptr<MimicOSBinding> attach(const std::string &ini_path,
+                                                  std::string *err);
+
+    ~MimicOSBinding();
+    MimicOSBinding(const MimicOSBinding &) = delete;
+    MimicOSBinding &operator=(const MimicOSBinding &) = delete;
+
+    /* False unless built with GEM5_USE_MIMICOS. */
+    static bool available();
+
+    /*
+     * 4K frames spanned by MimicOS's physical space, kernel reserve
+     * included: page table frames come from the bottom and data frames
+     * from above, so the numbers it returns cover the whole range.
+     */
+    uint64_t numFrames() const;
+
+    /* Base of the region reserved for MimicOS in gem5's space. */
+    void setPhysBase(Addr base);
+    Addr physBase() const;
+
+    /*
+     * Resolve the frame backing vaddr, allocating on first touch.
+     * paddr gets the gem5 physical address, log_bytes the page size.
+     */
+    bool allocate(Addr vaddr, uint32_t asid, Addr *paddr,
+                  unsigned *log_bytes);
+
+    /*
+     * Fault cost accrued since the last call, in ns, then reset.  The
+     * ISA's fault handler reads it once per fault to stall the thread.
+     */
+    uint64_t takePendingLatencyNs();
+
+    /* One line for the end of a run. */
+    std::string summary() const;
+
+  private:
+    MimicOSBinding();
+    struct Impl;
+    std::unique_ptr<Impl> impl;
+};
+
+} // namespace gem5
+
+#endif // __SIM_MIMICOS_BINDING_HH__
