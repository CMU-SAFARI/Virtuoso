+++ b/src/sim/mimicos_broker.cc
@@ -0,0 +1,225 @@
+/*
+ * Copyright (c) 2026 The Virtuoso Authors
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are
+ * met: redistributions of source code must retain the above copyright
+ * notice, this list of conditions and the following disclaimer;
+ * redistributions in binary form must reproduce the above copyright
+ * notice, this list of conditions and the following disclaimer in the
+ * documentation and/or other materials provided with the distribution;
+ * neither the name of the copyright holders nor the names of its
+ * contributors may be used to endorse or promote products derived from
+ * this software without specific prior written permission.
+ *
+ * THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS
+ * "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT
+ * LIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR
+ * A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT
+ * OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,
+ * SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT
+ * LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,
+ * DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY
+ * THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
+ * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE
+ * OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+/*
+ * @kanellok: the fault exchange, in order.
+ *
+ *   handOff()      application faults -> queue it, park the thread,
+ *                  wake the kernel
+ *   waitForFault() kernel asks for work -> hand it the next one
+ *   reply()        kernel answers -> remember the frame, wake whoever
+ *                  was waiting on that page
+ *   takeAnswer()   the parked thread runs again and picks it up
+ *
+ * Any number of threads can be waiting at once.  The kernel takes them
+ * one at a time, which is what a real fault handler does anyway.
+ */
+#include "sim/mimicos_broker.hh"
+
+#include <algorithm>
+
+#include "base/logging.hh"
+#include "base/trace.hh"
+#include "cpu/thread_context.hh"
+#include "sim/core.hh"
+#include "sim/process.hh"
+#include "debug/MimicOS.hh"
+
+namespace gem5
+{
+
+MimicOSBroker &
+MimicOSBroker::instance()
+{
+    static MimicOSBroker broker;
+    return broker;
+}
+
+void
+MimicOSBroker::enable(Addr phys_base, uint64_t kernel_pid)
+{
+    _enabled = true;
+    _phys_base = phys_base;
+    _kernel_pid = kernel_pid;
+}
+
+bool
+MimicOSBroker::handOff(ThreadContext *tc, Addr vaddr)
+{
+    if (!_enabled)
+        return false;
+
+    /*
+     * The kernel faults too, on its own text and stack, and it cannot
+     * serve those itself: it is not running yet when they happen, and
+     * handing it its own fault would wait forever.  They go down the
+     * normal path.
+     */
+    if (tc->getProcessPtr()->pid() == (int)_kernel_pid)
+        return false;
+
+    const Addr page = vaddr & ~(Addr)0xfff;
+    const uint64_t asid = tc->getProcessPtr()->pid();
+    const uint64_t k = key(asid, page);
+
+    /* Already answered: let the normal path pick the answer up. */
+    if (_answers.count(k))
+        return false;
+
+    /*
+     * Someone is already waiting on this page: either this same thread
+     * re-executing the faulting instruction before the park took
+     * effect, or another thread that wants the page too.  Join the
+     * queue rather than asking the kernel twice.
+     */
+    auto waiting = _parked.find(k);
+    if (waiting != _parked.end()) {
+        auto &list = waiting->second;
+        if (std::find(list.begin(), list.end(), tc) == list.end())
+            list.push_back(tc);
+        tc->quiesce();
+        return true;
+    }
+
+    /*
+     * The kernel may not have reached its first wait() yet -- it is a
+     * process like any other and has to start up.  Queue the fault and
+     * let it pick it up when it does.  Falling back to the simulator
+     * would be worse than a wait: the run would look fine having never
+     * used the kernel.
+     */
+    Fault f;
+    f.tc = tc;
+    f.vaddr = page;
+    f.asid = asid;
+    f.valid = true;
+    _queue.push_back(f);
+    _parked[k].push_back(tc);
+    _app_tc = tc;
+
+    DPRINTF(MimicOS, "queueing fault at %#x (asid %llu), %llu waiting\n",
+            page, (unsigned long long)asid,
+            (unsigned long long)_queue.size());
+
+    /* Park this thread.  Others keep running and may fault too. */
+    tc->quiesce();
+    if (_kernel_tc != nullptr)
+        _kernel_tc->activate();
+
+    return true;
+}
+
+bool
+MimicOSBroker::takeAnswer(uint64_t asid, Addr vaddr, Addr *paddr,
+                          unsigned *log_bytes)
+{
+    const Addr page = vaddr & ~(Addr)0xfff;
+    auto it = _answers.find(key(asid, page));
+    if (it == _answers.end())
+        return false;
+
+    if (paddr != nullptr)
+        *paddr = it->second.paddr;
+    if (log_bytes != nullptr)
+        *log_bytes = it->second.log_bytes;
+
+    _answers.erase(it);
+    return true;
+}
+
+uint64_t
+MimicOSBroker::waitForFault(ThreadContext *tc)
+{
+    _kernel_tc = tc;
+
+    /*
+     * Nothing more will ever fault once the application has gone, so
+     * let the kernel exit.  Without this the run never ends: a kernel
+     * waiting for work keeps the simulation alive for ever.
+     */
+    if (_app_tc != nullptr && _app_tc->status() == ThreadContext::Halted) {
+        DPRINTF(MimicOS, "application has gone, telling the kernel to stop\n");
+        return Shutdown;
+    }
+
+    if (!_serving.valid && !_queue.empty()) {
+        _serving = _queue.front();
+        _queue.pop_front();
+        DPRINTF(MimicOS, "kernel picked up the fault at %#x (asid %llu)\n",
+                _serving.vaddr, (unsigned long long)_serving.asid);
+        return _serving.vaddr;
+    }
+
+    /* Handed out already and not yet answered; hand out the same one. */
+    if (_serving.valid)
+        return _serving.vaddr;
+
+    /*
+     * Nothing to do.  Park the kernel rather than spin: a spinning
+     * kernel would burn simulated time that a real one does not.  It
+     * resumes at the instruction after this one, loops, and asks again.
+     *
+     * Wake it periodically as well as on a fault, so it notices when
+     * the application has gone.  Parked for good it would never look,
+     * and the run would never end.  A fault still wakes it at once.
+     */
+    DPRINTF(MimicOS, "kernel idle, parking\n");
+    tc->quiesceTick(curTick() + sim_clock::as_int::us);
+    return NoWork;
+}
+
+void
+MimicOSBroker::reply(ThreadContext *tc, uint64_t ppn, uint64_t page_size_bits)
+{
+    panic_if(!_serving.valid,
+             "MimicOS: the kernel answered without a fault to answer");
+
+    const unsigned log_bytes =
+        (page_size_bits >= 30) ? 30 : ((page_size_bits >= 21) ? 21 : 12);
+
+    const uint64_t k = key(_serving.asid, _serving.vaddr);
+    _answers[k] = Answer{_phys_base + (ppn << 12), log_bytes};
+    _served++;
+
+    DPRINTF(MimicOS, "kernel answered %#x with frame %llu, %u byte page\n",
+            _serving.vaddr, (unsigned long long)ppn, 1U << log_bytes);
+
+    /* Wake everyone waiting on this page, not just the first. */
+    auto it = _parked.find(k);
+    if (it != _parked.end()) {
+        for (auto *waiter : it->second)
+            waiter->activate();
+        _parked.erase(it);
+    }
+
+    _serving = Fault{};
+
+    (void)tc;
+}
+
+} // namespace gem5
