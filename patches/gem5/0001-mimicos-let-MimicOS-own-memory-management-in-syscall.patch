+#ifndef __SIM_MIMICOS_BROKER_HH__
+#define __SIM_MIMICOS_BROKER_HH__
+
+#include <cstdint>
+#include <deque>
+#include <unordered_map>
+#include <vector>
+
+#include "base/types.hh"
+
+namespace gem5
+{
+
+class ThreadContext;
+
+/*
+ * @kanellok: this is what makes gem5 run MimicOS for real.
+ *
+ * Normally a page fault in syscall emulation is resolved by the
+ * simulator calling a function, so the fault costs whatever number you
+ * put in a config file.  Here the fault is handed to MimicOS running as
+ * an ordinary process: it wakes up, works out which frame to use, and
+ * answers.  Its instructions go through the pipeline like the
+ * application's, so the fault costs what the handler actually does.
+ *
+ * Hands page faults to a MimicOS kernel running as a guest process.
+ *
+ * SE mode resolves a fault by calling into the simulator, so the cost of
+ * handling it can only ever be a number from a config file.  With the
+ * kernel in the guest, the fault is handed to it and the kernel's own
+ * instructions run through the pipeline like any others.  That is what
+ * makes the cost come from the handler.
+ *
+ * The exchange is two m5ops.  The kernel calls m5_mimicos_wait(), which
+ * blocks it until a fault is pending and then returns the address.  It
+ * works out which frame backs that address and calls
+ * m5_mimicos_reply().  Only then does the faulting thread run again.
+ *
+ * A fault takes two trips through the fault handler.  The first posts it
+ * and parks the thread; the second, after the kernel has answered, goes
+ * down gem5's normal path so the region checks in MemState still run --
+ * the answer is only used for the frame.
+ *
+ * Any number of threads may fault at once.  They queue, the kernel takes
+ * them one at a time, and each is woken when its own answer lands.
+ * Answers are keyed by address space as well as address, so two
+ * processes using the same virtual address do not collide.
+ */
+class MimicOSBroker
+{
+  public:
+    static MimicOSBroker &instance();
+
+    /*
+     * phys_base is where MimicOS's physical space starts in gem5's.
+     * kernel_pid is the process running the kernel: its own faults go
+     * down the normal path, since it cannot service them itself.
+     */
+    void enable(Addr phys_base, uint64_t kernel_pid);
+    bool enabled() const { return _enabled; }
+
+    /* True once a kernel has called wait() at least once. */
+    bool kernelPresent() const { return _kernel_tc != nullptr; }
+
+    /*
+     * Called from the ISA's fault handler before it resolves anything.
+     * Returns true when the fault has been handed to the kernel and the
+     * caller should return without fixing it: the thread is parked and
+     * will re-run the instruction once the kernel answers.
+     */
+    bool handOff(ThreadContext *tc, Addr vaddr);
+
+    /*
+     * The frame the kernel gave for this address, if it has answered.
+     * Consumes the answer.  log_bytes gets the page size it chose.
+     */
+    bool takeAnswer(uint64_t asid, Addr vaddr, Addr *paddr,
+                    unsigned *log_bytes);
+
+    /* Address space of the fault the kernel is serving right now. */
+    uint64_t servingAsid() const { return _serving.asid; }
+
+    /*
+     * m5_mimicos_wait().  Returns the faulting address, or one of the
+     * two values below.
+     *
+     * Address 0 is a real address -- a null dereference faults there --
+     * so it cannot double as "nothing to do".  Using it as one made the
+     * kernel skip a genuine fault and spin on it for ever.
+     */
+    static constexpr uint64_t Shutdown = ~(uint64_t)0;
+    static constexpr uint64_t NoWork = ~(uint64_t)1;
+    uint64_t waitForFault(ThreadContext *tc);
+
+    /* m5_mimicos_reply() */
+    void reply(ThreadContext *tc, uint64_t ppn, uint64_t page_size_bits);
+
+    uint64_t served() const { return _served; }
+
+  private:
+    MimicOSBroker() = default;
+
+    struct Answer
+    {
+        Addr paddr;
+        unsigned log_bytes;
+    };
+
+    struct Fault
+    {
+        ThreadContext *tc = nullptr;
+        Addr vaddr = 0;
+        uint64_t asid = 0;
+        bool valid = false;
+    };
+
+    /* One key per address space and page. */
+    static uint64_t key(uint64_t asid, Addr page)
+    {
+        return (asid << 48) ^ (page >> 12);
+    }
+
+    bool _enabled = false;
+    Addr _phys_base = 0;
+    uint64_t _kernel_pid = 0;
+
+    ThreadContext *_kernel_tc = nullptr;
+
+    /* Faults waiting for the kernel, and the one it has in hand. */
+    std::deque<Fault> _queue;
+    Fault _serving;
+
+    /*
+     * Threads parked on a fault.  More than one can be waiting on the
+     * same page -- they touch it at the same time and both fault before
+     * either is served -- and every one of them has to be woken, or the
+     * ones left behind sleep for ever and their work is lost.
+     */
+    std::unordered_map<uint64_t, std::vector<ThreadContext *>> _parked;
+
+    /* Any application thread, to notice when the workload is done. */
+    ThreadContext *_app_tc = nullptr;
+
+    std::unordered_map<uint64_t, Answer> _answers;
+
+    uint64_t _served = 0;
+};
+
+} // namespace gem5
+
+#endif // __SIM_MIMICOS_BROKER_HH__
diff --git a/src/sim/process.cc b/src/sim/process.cc
index 7b6e2d0..e7f3a53 100644
--- a/src/sim/process.cc
+++ b/src/sim/process.cc
@@ -336,11 +336,77 @@ Process::allocateMem(Addr vaddr, int64_t size, bool clobber)
     }
 
     const int npages = divCeil(size, page_size);
+    const auto flags = clobber ? EmulationPageTable::Clobber :
+                                 EmulationPageTable::MappingFlags(0);
+
+    /*
+     * @kanellok: where the frames for this process come from.
+     *
+     * With MimicOS, one page at a time, because it decides placement
+     * from the virtual address.  Without it, one contiguous run as
+     * before.
+     */
+    if (seWorkload->mimicosEnabled()) {
+        /*
+         * MimicOS places frames by virtual address: its buddy allocator
+         * and THP reservation both key off it.  So resolve one page at
+         * a time rather than take one contiguous run, and let physical
+         * contiguity reflect what the allocator decided.
+         */
+        for (int i = 0; i < npages; i++) {
+            const Addr va = page_addr + i * page_size;
+            unsigned log_bytes = 12;
+            const Addr pa = seWorkload->mimicosAllocPage(va, pTable->pid(),
+                                                         &log_bytes);
+            /*
+             * Record the real page size.  The table still holds one
+             * entry per 4K page; the TLB needs the size so a 2M page
+             * takes one entry instead of 512.
+             */
+            auto page_flags = flags;
+
+            /*
+             * A large TLB entry answers for the whole region, so it is
+             * only safe if every page in that region really is backed
+             * by this allocation.  Anything mapped earlier -- the
+             * binary's text and data are mapped before the kernel is
+             * even running -- would otherwise be silently redirected
+             * into the large frame, and the program would read someone
+             * else's memory.  When that has happened, keep 4K entries.
+             */
+            if (log_bytes >= 21) {
+                const Addr region = Addr(1) << log_bytes;
+                const Addr huge_va = va & ~(region - 1);
+                const Addr huge_pa = pa & ~(region - 1);
+                const int covered = int(region / page_size);
+
+                bool clean = true;
+                for (int j = 0; j < covered; j++) {
+                    if (pTable->lookup(huge_va + j * page_size)) {
+                        clean = false;
+                        break;
+                    }
+                }
+
+                if (clean) {
+                    page_flags = EmulationPageTable::MappingFlags(
+                            page_flags | (log_bytes >= 30
+                                          ? EmulationPageTable::Huge1G
+                                          : EmulationPageTable::Huge2M));
+                    /* Map the whole region so the entry tells the truth. */
+                    pTable->map(huge_va, huge_pa, region, page_flags);
+                    continue;
+                }
+            }
+
+            pTable->map(va, pa, page_size, page_flags);
+        }
+        return;
+    }
+
     const Addr paddr = seWorkload->allocPhysPages(npages);
     const Addr pages_size = npages * page_size;
-    pTable->map(page_addr, paddr, pages_size,
-                clobber ? EmulationPageTable::Clobber :
-                          EmulationPageTable::MappingFlags(0));
+    pTable->map(page_addr, paddr, pages_size, flags);
 }
 
