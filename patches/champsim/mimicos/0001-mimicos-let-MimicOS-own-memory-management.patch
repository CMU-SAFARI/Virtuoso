+#include <catch.hpp>
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <set>
+#include <string>
+#include <unistd.h>
+
+#include "dram_controller.h"
+#include "vmem.h"
+
+/*
+ * MimicOS-backed VirtualMemory.
+ *
+ * These are ChampSim-side tests: they check that the *adapter* behaves, given
+ * that libmimicos itself is covered by mimicos/tests/embed_smoke.cc. The
+ * distinction matters -- a bug here looks identical to a bug there unless the
+ * two are tested separately.
+ *
+ * Without -DCHAMPSIM_MIMICOS the whole file reduces to one test asserting that
+ * MimicOS is reported as unavailable, so the suite still builds and passes in
+ * a stock checkout.
+ */
+
+namespace
+{
+MEMORY_CONTROLLER make_dram()
+{
+  return MEMORY_CONTROLLER{champsim::chrono::picoseconds{3200},
+                           champsim::chrono::picoseconds{6400},
+                           std::size_t{18},
+                           std::size_t{18},
+                           std::size_t{18},
+                           std::size_t{38},
+                           champsim::chrono::microseconds{64000},
+                           {},
+                           64,
+                           64,
+                           1,
+                           champsim::data::bytes{8},
+                           65536,
+                           1024,
+                           4,
+                           8,
+                           4,
+                           8192};
+}
+
+/*
+ * A MimicOS config small enough to fit inside the DRAM model above, written to
+ * a temporary file. Generating it here rather than shipping a fixture keeps the
+ * test honest about exactly which knobs it depends on.
+ */
+class TempConfig
+{
+public:
+  explicit TempConfig(const std::string& allocator, unsigned levels = 5, double promotion_threshold = 0.5)
+  {
+    char name_template[] = "/tmp/champsim_mimicos_XXXXXX";
+    const int fd = mkstemp(name_template);
+    REQUIRE(fd >= 0);
+    ::close(fd);
+    path_ = name_template;
+
+    std::ofstream out(path_);
+    out << "[allocator]\n"
+        << "memory_allocator = " << allocator << "\n"
+        << "max_order = 12\n\n"
+        << "[page_table]\n"
+        << "levels = " << levels << "\n"
+        << "page_size = 4096\n\n"
+        << "[pmem_alloc]\n"
+        << "memory_size = 1024\n"
+        << "kernel_size = 128\n"
+        << "max_order = 12\n"
+        << "frag_type = largepage\n"
+        << "target_fragmentation = 0.0\n"
+        << "threshold_for_promotion = " << promotion_threshold << "\n\n"
+        << "[fault_calibration]\n"
+        << "vma_lookup_base = 100\n"
+        << "pt_page_alloc_cost = 200\n"
+        << "phys_page_alloc_cost = 400\n"
+        << "zero_fill_cost = 800\n"
+        << "pte_install_cost = 50\n";
+  }
+
+  ~TempConfig() { std::remove(path_.c_str()); }
+
+  TempConfig(const TempConfig&) = delete;
+  TempConfig& operator=(const TempConfig&) = delete;
+
+  const std::string& path() const { return path_; }
+
+private:
+  std::string path_;
+};
+} // namespace
+
+#ifdef CHAMPSIM_MIMICOS
+
+SCENARIO("MimicOS backs the virtual memory when a config is supplied")
+{
+  GIVEN("A virtual memory with MimicOS attached")
+  {
+    constexpr unsigned levels = 5;
+    TempConfig config{"baseline", levels};
+    auto dram = make_dram();
+    VirtualMemory uut{champsim::data::bytes{1ull << 12}, levels, std::chrono::nanoseconds{6400}, dram, {}, config.path()};
+
+    THEN("It reports MimicOS as enabled") { REQUIRE(uut.mimicos_enabled()); }
+
+    WHEN("A page is translated twice")
+    {
+      const champsim::page_number vpage{0x12345};
+      auto [ppage_a, delay_a] = uut.va_to_pa(0, vpage);
+      auto [ppage_b, delay_b] = uut.va_to_pa(0, vpage);
+
+      THEN("The first access faults and the second does not")
+      {
+        REQUIRE(delay_a > champsim::chrono::clock::duration::zero());
+        REQUIRE(delay_b == champsim::chrono::clock::duration::zero());
+      }
+
+      THEN("The translation is stable") { REQUIRE(ppage_a == ppage_b); }
+
+      THEN("The fault carries MimicOS's calibrated cost, not ChampSim's default")
+      {
+        // 100 + 200 + 400 + 800 + 50 = 1550 ns for a 4 KiB anonymous write
+        // that installs page-table pages.
+        REQUIRE(delay_a == champsim::chrono::clock::duration{std::chrono::nanoseconds{1550}});
+      }
+    }
+
+    WHEN("Many distinct pages are translated")
+    {
+      std::set<champsim::page_number> seen;
+      constexpr int count = 400;
+      for (int i = 0; i < count; i++) {
+        auto [ppage, delay] = uut.va_to_pa(0, champsim::page_number{0x40000 + static_cast<uint64_t>(i)});
+        (void)delay;
+        seen.insert(ppage);
+      }
+
+      THEN("No two virtual pages share a frame") { REQUIRE(seen.size() == count); }
+    }
+
+    WHEN("Two address spaces translate the same virtual page")
+    {
+      const champsim::page_number vpage{0x9999};
+      auto [ppage_a, delay_a] = uut.va_to_pa(0, vpage);
+      auto [ppage_b, delay_b] = uut.va_to_pa(1, vpage);
+      (void)delay_a;
+      (void)delay_b;
+
+      THEN("They get different frames") { REQUIRE(ppage_a != ppage_b); }
+    }
+  }
+}
+
+SCENARIO("MimicOS supplies the page-table entry addresses for a walk")
+{
+  GIVEN("A virtual memory with MimicOS attached")
+  {
+    constexpr unsigned levels = 5;
+    TempConfig config{"baseline", levels};
+    auto dram = make_dram();
+    VirtualMemory uut{champsim::data::bytes{1ull << 12}, levels, std::chrono::nanoseconds{6400}, dram, {}, config.path()};
+
+    WHEN("A full walk is performed")
+    {
+      const champsim::page_number vpage{0x123456};
+      std::vector<champsim::address> entries;
+      for (std::size_t level = levels; level >= 1; level--) {
+        auto [paddr, delay] = uut.get_pte_pa(0, vpage, level);
+        (void)delay;
+        entries.push_back(paddr);
+      }
+
+      THEN("There is one entry per level") { REQUIRE(entries.size() == levels); }
+
+      THEN("Every entry is 8-byte aligned")
+      {
+        for (auto entry : entries) {
+          REQUIRE(entry.to<uint64_t>() % 8 == 0);
+        }
+      }
+
+      THEN("Each level lives in its own page-table frame")
+      {
+        std::set<uint64_t> frames;
+        for (auto entry : entries) {
+          frames.insert(entry.to<uint64_t>() / 4096);
+        }
+        REQUIRE(frames.size() == levels);
+      }
+
+      THEN("The entry offsets match the virtual address's index bits")
+      {
+        const uint64_t vaddr = champsim::address{vpage}.to<uint64_t>();
+        for (std::size_t depth = 0; depth < levels; depth++) {
+          const uint64_t shift = 12 + 9 * (levels - 1 - depth);
+          const uint64_t expected = (vaddr >> shift) & 0x1ff;
+          const uint64_t actual = (entries.at(depth).to<uint64_t>() % 4096) / 8;
+          REQUIRE(actual == expected);
+        }
+      }
+    }
+
+    WHEN("A 4 KiB page has been mapped")
+    {
+      const champsim::page_number vpage{0x777777};
+      auto [ppage, delay] = uut.va_to_pa(0, vpage);
+      (void)ppage;
+      (void)delay;
+
+      THEN("The walk runs to full depth") { REQUIRE(uut.min_translation_level(0, vpage) == 0); }
+    }
+  }
+}
+
+SCENARIO("A promoted huge page shortens the walk")
+{
+  GIVEN("A virtual memory backed by the reservation-THP allocator")
+  {
+    constexpr unsigned levels = 5;
+    // Promote as soon as a 2 MiB region is touched at all, so the test does
+    // not depend on how many pages the allocator wants to see first.
+    TempConfig config{"reserve_thp", levels, 0.0};
+    auto dram = make_dram();
+    VirtualMemory uut{champsim::data::bytes{1ull << 12}, levels, std::chrono::nanoseconds{6400}, dram, {}, config.path()};
+
+    WHEN("A page in a promoted region is translated")
+    {
+      const champsim::page_number vpage{0x20000};
+      auto [ppage, delay] = uut.va_to_pa(0, vpage);
+      (void)delay;
+
+      THEN("The frame is 2 MiB aligned") { REQUIRE(ppage.to<uint64_t>() % 512 == 0); }
+
+      THEN("The walk stops one level early") { REQUIRE(uut.min_translation_level(0, vpage) == 1); }
+
+      AND_WHEN("Another page inside the same 2 MiB region is translated")
+      {
+        const champsim::page_number inner{vpage.to<uint64_t>() + 100};
+        auto [inner_ppage, inner_delay] = uut.va_to_pa(0, inner);
+
+        THEN("It resolves inside the huge frame without faulting")
+        {
+          REQUIRE(inner_ppage.to<uint64_t>() == ppage.to<uint64_t>() + 100);
+          REQUIRE(inner_delay == champsim::chrono::clock::duration::zero());
+        }
+      }
+    }
+  }
+}
+
+SCENARIO("The virtual memory reports the page size it handed out")
+{
+  GIVEN("A virtual memory backed by the reservation-THP allocator")
+  {
+    constexpr unsigned levels = 5;
+    TempConfig config{"reserve_thp", levels, 0.0};
+    auto dram = make_dram();
+    VirtualMemory uut{champsim::data::bytes{1ull << 12}, levels, std::chrono::nanoseconds{6400}, dram, {}, config.path()};
+
+    WHEN("A page has not been touched")
+    {
+      THEN("It reads as a small page rather than faulting anything in")
+      {
+        REQUIRE(uut.page_shift(0, champsim::page_number{0x50000}) == 12);
+        REQUIRE(uut.available_ppages() > 0);
+      }
+    }
+
+    WHEN("A 2 MiB page has been mapped")
+    {
+      const champsim::page_number vpage{0x40000};
+      auto [ppage, delay] = uut.va_to_pa(0, vpage);
+      (void)delay;
+
+      THEN("Every small page inside it reports the huge size")
+      {
+        REQUIRE(uut.page_shift(0, vpage) == 21);
+        for (uint64_t off : {uint64_t{1}, uint64_t{17}, uint64_t{511}}) {
+          REQUIRE(uut.page_shift(0, champsim::page_number{vpage.to<uint64_t>() + off}) == 21);
+        }
+      }
+
+      THEN("Their translations stay inside the same huge frame")
+      {
+        const auto base = ppage.to<uint64_t>();
+        for (uint64_t off : {uint64_t{1}, uint64_t{17}, uint64_t{511}}) {
+          auto [inner, inner_delay] = uut.va_to_pa(0, champsim::page_number{vpage.to<uint64_t>() + off});
+          (void)inner_delay;
+          REQUIRE(inner.to<uint64_t>() == base + off);
+        }
+      }
+    }
+  }
+}
+
+SCENARIO("A virtual memory without a MimicOS config keeps the stock model")
+{
+  GIVEN("A virtual memory built the stock way")
+  {
+    auto dram = make_dram();
+    VirtualMemory uut{champsim::data::bytes{1ull << 12}, 5, std::chrono::nanoseconds{6400}, dram};
+
+    THEN("MimicOS is not enabled") { REQUIRE_FALSE(uut.mimicos_enabled()); }
+
+    THEN("Every walk runs to full depth") { REQUIRE(uut.min_translation_level(0, champsim::page_number{0x1234}) == 0); }
+
+    THEN("Every page reads as a small page") { REQUIRE(uut.page_shift(0, champsim::page_number{0x1234}) == 12); }
+
+    WHEN("A page faults")
+    {
+      auto [ppage, delay] = uut.va_to_pa(0, champsim::page_number{0x1234});
+      (void)ppage;
+
+      THEN("The configured minor fault penalty is charged")
+      {
+        REQUIRE(delay == champsim::chrono::clock::duration{std::chrono::nanoseconds{6400}});
+      }
+    }
+  }
+}
