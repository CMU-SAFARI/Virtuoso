diff --git a/Makefile b/Makefile
index 6aae9c9..4879d56 100644
--- a/Makefile
+++ b/Makefile
@@ -20,6 +20,26 @@ override CPPFLAGS += -I$(OBJ_ROOT)
 override LDFLAGS  += -L$(TRIPLET_DIR)/lib -L$(TRIPLET_DIR)/lib/manual-link
 override LDLIBS   += -lCLI11 -llzma -lz -lbz2 -lfmt
 
+# @kanellok: MimicOS integration (opt-in).
+#
+#   make MIMICOS_HOME=/path/to/virtuoso_artifact/mimicos
+#
+# Without MIMICOS_HOME the build is stock ChampSim: src/vmem_mimicos.cc
+# compiles to stubs and nothing links against MimicOS.  With it, VirtualMemory
+# can hand physical allocation and the page tables to MimicOS -- see
+# inc/vmem_mimicos.h.  MIMICOS_SNIPER_INCLUDE points at the shared allocator
+# headers; it defaults to the layout of the Virtuoso artifact repository.
+ifdef MIMICOS_HOME
+MIMICOS_SNIPER_INCLUDE ?= $(MIMICOS_HOME)/../simulator/sniper/include
+MIMICOS_LIB ?= $(MIMICOS_HOME)/build/libmimicos.a
+override CPPFLAGS += -DCHAMPSIM_MIMICOS -I$(MIMICOS_HOME)/include -I$(MIMICOS_SNIPER_INCLUDE)
+override LDLIBS   += $(MIMICOS_LIB)
+# Relinking when libmimicos.a changes has to be stated explicitly: LDLIBS is
+# passed to the linker but is not a prerequisite, so without this a rebuilt
+# MimicOS would silently leave the old one linked in.
+override MIMICOS_LINK_PREREQ := $(MIMICOS_LIB)
+endif
+
 .PHONY: all clean compile_commands compile_commands_clean configclean test pytest maketest
 
 test_main_name=test/bin/000-test-main
@@ -214,6 +234,10 @@ endif
 
 all: $(executable_name)
 
+ifdef MIMICOS_HOME
+$(executable_name): $(MIMICOS_LINK_PREREQ)
+endif
+
 # Get the base object files, with the 'main' file mangled
 # $1 - A unique key identifying the build
 get_base_objs = $(call get_object_list,$(base_source_dir),$(OBJ_ROOT),$1)
