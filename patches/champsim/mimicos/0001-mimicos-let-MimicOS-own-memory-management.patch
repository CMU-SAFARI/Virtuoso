+/*
+ * @kanellok: a large entry is filed under the large page number, so a
+ * lookup that indexes on the 4K page number cannot find it.  That is
+ * why every TLB lookup probes twice.
+ */
+auto CACHE::matches_huge_address(champsim::address addr) const
+{
+  return [match = addr.slice_upper(HUGE_SHIFT), shamt = HUGE_SHIFT, huge = static_cast<uint8_t>(champsim::to_underlying(HUGE_SHIFT))](const auto& entry) {
+    return entry.page_shift == huge && entry.address.slice_upper(shamt) == match;
+  };
+}
+
+/* Page size backing this address, from whoever owns the page tables. */
+unsigned CACHE::page_shift_of(champsim::address addr) const
+{
+  if (vmem == nullptr) {
+    return static_cast<unsigned>(champsim::to_underlying(OFFSET_BITS));
+  }
+  return vmem->page_shift(cpu, champsim::page_number{addr});
+}
