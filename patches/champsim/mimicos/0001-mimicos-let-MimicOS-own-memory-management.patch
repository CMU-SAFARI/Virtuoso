+
+#ifndef VMEM_MIMICOS_H
+#define VMEM_MIMICOS_H
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+/*
+ * @kanellok: this is the seam between ChampSim and MimicOS.
+ *
+ * ChampSim normally invents its own physical addresses.  With MimicOS
+ * attached, it asks MimicOS instead, and gets back the same answers a
+ * real OS allocator would give.  Everything MimicOS-shaped is hidden
+ * behind this one class so the rest of ChampSim never sees it.
+ *
+ * Bridge to the MimicOS library (mimicos/include/mimicos_embed.h).
+ *
+ * With MimicOS attached it decides which frame backs a page, how big
+ * that page is, what a fault costs, and where every page table entry
+ * lives.  The page table walker then reads those entries through the
+ * real cache hierarchy, so allocator policy shows up in measured
+ * traffic instead of being assumed away.
+ *
+ * No MimicOS types appear here; they sit behind a pimpl so vmem.h, and
+ * most of ChampSim with it, stays free of the dependency.  Built
+ * without -DCHAMPSIM_MIMICOS this is all stubs and attach() fails, so a
+ * stock build is unchanged.
+ */
+class MimicOSBinding
+{
+public:
+  struct MapResult {
+    uint64_t ppn = 0;             ///< 4 KiB-granular frame containing the address
+    uint32_t page_size_bits = 12; ///< 12, 21 or 30
+    bool faulted = false;         ///< this call resolved a minor fault
+    uint64_t fault_latency_ns = 0;///< 0 when the calibration model is unset
+    bool ok = false;
+  };
+
+  /*
+   * Attach MimicOS from an INI, the same file the standalone kernel
+   * takes.  Returns null with *err set on failure.
+   *
+   * pt_levels must match ChampSim's configured depth or the entries
+   * handed back belong to a different walk.  dram_bytes bounds the
+   * MimicOS pool: frames above it are addresses the memory controller
+   * cannot serve.
+   */
+  static std::unique_ptr<MimicOSBinding> attach(const std::string& ini_path, std::size_t pt_levels, uint64_t dram_bytes,
+                                                std::string* err);
+
+  ~MimicOSBinding();
+  MimicOSBinding(const MimicOSBinding&) = delete;
+  MimicOSBinding& operator=(const MimicOSBinding&) = delete;
+
+  /* False unless built with -DCHAMPSIM_MIMICOS. */
+  static bool available();
+
+  /* Resolve a page, faulting it in if it is not mapped. */
+  MapResult translate(uint32_t cpu_num, uint64_t vpage);
+
+  /*
+   * Address of the entry read at `level`, where pt_levels is the root
+   * and 1 the last table.  Interior tables are created on demand, so
+   * this works before the leaf mapping exists.
+   */
+  bool pte_paddr(uint32_t cpu_num, uint64_t vpage, std::size_t level, uint64_t* out);
+
+  /* Address of the root table. */
+  uint64_t root_paddr(uint32_t cpu_num);
+
+  /*
+   * Lowest level the walk reaches: 0 for 4K, 1 for 2M, 2 for 1G.  A
+   * large page ends the walk early.
+   */
+  std::size_t min_translation_level(uint32_t cpu_num, uint64_t vpage);
+
+  /* log2 of the page size backing this page, 12 if unmapped.  Never allocates. */
+  unsigned page_shift(uint32_t cpu_num, uint64_t vpage) const;
+
+  /* Free 4K frames left. */
+  uint64_t available_frames() const;
+
+  /* One line for the end of a run. */
+  std::string summary() const;
+
+private:
+  MimicOSBinding();
+  struct Impl;
+  std::unique_ptr<Impl> impl;
+};
+
+#endif
