new file mode 100644
index 0000000..223f1a2
--- /dev/null
+++ b/src/vmem_mimicos.cc
@@ -0,0 +1,233 @@
+/*
+ *    MimicOS integration for ChampSim.
+ *
+ *    Licensed under the Apache License, Version 2.0 (the "License");
+ *    you may not use this file except in compliance with the License.
+ *    You may obtain a copy of the License at
+ *
+ *    http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+/*
+ * @kanellok: every question ChampSim asks MimicOS goes through here.
+ *
+ *   translate()   which frame backs this page, and how big is it
+ *   pte_paddr()   where the page table entry for this level lives, so
+ *                 the walker can actually fetch it
+ *   page_shift()  4K or 2M, for the TLBs
+ *
+ * Built without -DCHAMPSIM_MIMICOS this file is all stubs.
+ */
+#include "vmem_mimicos.h"
+
+#include <cstdlib>
+#include <sstream>
+
+#ifdef CHAMPSIM_MIMICOS
+
+#include "mimicos_embed.h"
+
+#include <fmt/core.h>
+
+namespace
+{
+constexpr uint64_t LOG2_4KB = 12;
+
+mimicos::FaultRequest make_request(uint32_t cpu_num, uint64_t vpage)
+{
+  mimicos::FaultRequest req;
+  req.vaddr = vpage << LOG2_4KB;
+  /* One page table per core, matching ChampSim's own vpage_to_ppage_map key. */
+  req.asid = cpu_num;
+  req.core_id = cpu_num;
+  /*
+   * Traces carry no mapping type or permissions, so every fault is an
+   * anonymous write.  The standalone kernel assumes the same when it has
+   * no VMA information.
+   */
+  req.access = mimicos::AccessType::WRITE;
+  req.mapping = mimicos::MappingType::ANON;
+  return req;
+}
+} // namespace
+
+struct MimicOSBinding::Impl {
+  std::unique_ptr<mimicos::Kernel> kernel;
+  std::size_t pt_levels = 0;
+  uint64_t translations = 0;
+};
+
+bool MimicOSBinding::available() { return true; }
+
+MimicOSBinding::MimicOSBinding() : impl(std::make_unique<Impl>()) {}
+MimicOSBinding::~MimicOSBinding()
+{
+  if (impl && impl->kernel) {
+    impl->kernel->flush_mapping_trace();
+  }
+}
+
+std::unique_ptr<MimicOSBinding> MimicOSBinding::attach(const std::string& ini_path, std::size_t pt_levels, uint64_t dram_bytes,
+                                                       std::string* err)
+{
+  mimicos::KernelConfig cfg;
+  if (!mimicos::KernelConfig::from_ini(ini_path, &cfg, err)) {
+    return nullptr;
+  }
+
+  /*
+   * ChampSim's depth is fixed at configuration time and baked into the
+   * PSCL geometry, so MimicOS has to build a tree of the same depth or
+   * the entries it hands back belong to a different walk.
+   */
+  cfg.pt_levels = static_cast<int>(pt_levels);
+
+  auto kernel = mimicos::Kernel::create(cfg, err);
+  if (kernel == nullptr) {
+    return nullptr;
+  }
+
+  /* Frames above the end of DRAM are addresses nothing can serve. */
+  const uint64_t mimicos_bytes = cfg.memory_size_mb * 1024ull * 1024ull;
+  if (mimicos_bytes > dram_bytes) {
+    std::ostringstream oss;
+    oss << "MimicOS physical memory (" << cfg.memory_size_mb << " MB) exceeds ChampSim DRAM (" << (dram_bytes / (1024 * 1024))
+        << " MB); reduce [pmem_alloc] memory_size or enlarge the DRAM model";
+    if (err != nullptr) {
+      *err = oss.str();
+    }
+    return nullptr;
+  }
+
+  std::unique_ptr<MimicOSBinding> binding(new MimicOSBinding());
+  binding->impl->kernel = std::move(kernel);
+  binding->impl->pt_levels = pt_levels;
+
+  /*
+   * In the standalone kernel [fault_calibration] holds corrections on
+   * top of handler code that SDE simulates instruction by instruction.
+   * Here MimicOS runs natively and is never simulated, so those values
+   * are the whole cost model.  A config carried over from a Sniper run
+   * reads zero, which would make faults free, so say something.
+   */
+  mimicos::FaultRequest probe;
+  if (binding->impl->kernel->minor_fault_latency_ns(probe, 12, true) == 0) {
+    fmt::print(stderr,
+               "[VMEM] WARNING: MimicOS config '{}' has an all-zero [fault_calibration] section.\n"
+               "                Under the embedding library those values are the whole minor-fault\n"
+               "                cost model, not a correction on top of simulated kernel execution,\n"
+               "                so ChampSim's configured minor_fault_penalty will be used instead.\n",
+               ini_path);
+  }
+
+  /* Log mapping decisions so a run can be replayed and compared. */
+  if (const char* trace_path = std::getenv("MIMICOS_MAPPING_TRACE"); trace_path != nullptr && trace_path[0] != '\0') {
+    std::string trace_err;
+    if (!binding->impl->kernel->enable_mapping_trace(trace_path, &trace_err)) {
+      if (err != nullptr) {
+        *err = trace_err;
+      }
+      return nullptr;
+    }
+    fmt::print("[VMEM] MimicOS mapping trace -> '{}'\n", trace_path);
+  }
+
+  return binding;
+}
+
+auto MimicOSBinding::translate(uint32_t cpu_num, uint64_t vpage) -> MapResult
+{
+  MapResult out;
+  const auto t = impl->kernel->translate(make_request(cpu_num, vpage));
+  impl->translations++;
+
+  out.ok = t.ok;
+  out.ppn = t.ppn;
+  out.page_size_bits = t.page_size_bits;
+  out.faulted = t.faulted;
+  out.fault_latency_ns = t.fault_latency_ns;
+  return out;
+}
+
+bool MimicOSBinding::pte_paddr(uint32_t cpu_num, uint64_t vpage, std::size_t level, uint64_t* out)
+{
+  mimicos::PtwStep step;
+  if (!impl->kernel->pte_address(make_request(cpu_num, vpage), static_cast<uint32_t>(level), &step)) {
+    return false;
+  }
+  if (out != nullptr) {
+    *out = step.pte_paddr;
+  }
+  return true;
+}
+
+uint64_t MimicOSBinding::root_paddr(uint32_t cpu_num) { return impl->kernel->root_table_paddr(cpu_num); }
+
+std::size_t MimicOSBinding::min_translation_level(uint32_t cpu_num, uint64_t vpage)
+{
+  /*
+   * MimicOS names the level its leaf sits at; ChampSim counts levels
+   * remaining and reaches 0 on the final step.  Hence the -1.
+   */
+  const uint32_t leaf = impl->kernel->leaf_level(cpu_num, vpage << LOG2_4KB);
+  return static_cast<std::size_t>(leaf > 0 ? leaf - 1 : 0);
+}
+
+unsigned MimicOSBinding::page_shift(uint32_t cpu_num, uint64_t vpage) const
+{
+  uint64_t ppn = 0;
+  uint32_t bits = 12;
+  if (!impl->kernel->probe(cpu_num, vpage << LOG2_4KB, &ppn, &bits)) {
+    return 12;
+  }
+  return bits;
+}
+
+uint64_t MimicOSBinding::available_frames() const { return impl->kernel->available_frames(); }
+
+std::string MimicOSBinding::summary() const
+{
+  const auto s = impl->kernel->stats();
+  std::ostringstream oss;
+  oss << "MimicOS: " << s.translations << " translations, " << s.minor_faults << " minor faults (" << s.huge_page_faults
+      << " huge), " << s.data_frames_allocated << " data frames, " << s.pt_frames_allocated << " page-table frames";
+  if (s.failed_allocations > 0) {
+    oss << ", " << s.failed_allocations << " FAILED allocations";
+  }
+  if (s.aliased_frames > 0) {
+    oss << ", " << s.aliased_frames << " ALIASED frames";
+  }
+  return oss.str();
+}
+
+#else /* !CHAMPSIM_MIMICOS — stubs so a stock build has no MimicOS dependency */
+
+struct MimicOSBinding::Impl {
+};
+
+bool MimicOSBinding::available() { return false; }
+
+MimicOSBinding::MimicOSBinding() : impl(nullptr) {}
+MimicOSBinding::~MimicOSBinding() = default;
+
+std::unique_ptr<MimicOSBinding> MimicOSBinding::attach(const std::string& ini_path, std::size_t pt_levels, uint64_t dram_bytes,
+                                                       std::string* err)
+{
+  (void)ini_path;
+  (void)pt_levels;
+  (void)dram_bytes;
+  if (err != nullptr) {
+    *err = "this ChampSim was built without MimicOS support; rebuild with MIMICOS_HOME=<path to mimicos> to enable it";
+  }
+  return nullptr;
+}
+
+auto MimicOSBinding::translate(uint32_t, uint64_t) -> MapResult { return MapResult{}; }
+bool MimicOSBinding::pte_paddr(uint32_t, uint64_t, std::size_t, uint64_t*) { return false; }
+uint64_t MimicOSBinding::root_paddr(uint32_t) { return 0; }
+std::size_t MimicOSBinding::min_translation_level(uint32_t, uint64_t) { return 0; }
+unsigned MimicOSBinding::page_shift(uint32_t, uint64_t) const { return 12; }
+uint64_t MimicOSBinding::available_frames() const { return 0; }
+std::string MimicOSBinding::summary() const { return {}; }
+
+#endif
