+long CACHE::get_huge_set_index(champsim::address address) const
+{
+  return address.slice(champsim::dynamic_extent{HUGE_SHIFT, champsim::lg2(NUM_SET_HUGE)}).to<long>();
+}
+
+auto CACHE::get_huge_set_span(champsim::address address) -> std::pair<set_type::iterator, set_type::iterator>
+{
+  const auto set_idx = get_huge_set_index(address);
+  assert(set_idx >= 0);
+  assert(set_idx < NUM_SET_HUGE);
+  const auto begin = std::next(std::begin(block_huge), set_idx * NUM_WAY_HUGE);
+  return {begin, std::next(begin, NUM_WAY_HUGE)};
+}
+
+/* Returns end() of whichever array was searched when there is no hit. */
+auto CACHE::find_huge_entry(champsim::address addr) -> set_type::iterator
+{
+  auto matcher = matches_huge_address(addr);
+
+  if (NUM_WAY_HUGE > 0) {
+    auto [begin, end] = get_huge_set_span(addr);
+    auto way = std::find_if(begin, end, [&](const auto& x) { return x.valid && matcher(x); });
+    return way == end ? std::end(block_huge) : way;
+  }
+
+  /* Unified: huge entries live in the main array at the huge index. */
+  auto [begin, end] = get_unified_huge_span(addr);
+  auto way = std::find_if(begin, end, [&](const auto& x) { return x.valid && matcher(x); });
+  return way == end ? std::end(block) : way;
+}
+
+/* Indexing on the large page number is what lets one entry cover all of it. */
+/*
+ * Install a large entry.  A TLB never writes back, so the victim is
+ * just dropped.  The separate array uses plain LRU; the shared one
+ * reuses the configured replacement module, which is fine because the
+ * set index still refers to the main array.
+ */
+void CACHE::fill_huge_entry(const mshr_type& fill_mshr, unsigned shift)
+{
+  set_type::iterator set_begin;
+  set_type::iterator set_end;
+  bool unified = (NUM_WAY_HUGE == 0);
+
+  if (unified) {
+    std::tie(set_begin, set_end) = get_unified_huge_span(fill_mshr.address);
+  } else {
+    std::tie(set_begin, set_end) = get_huge_set_span(fill_mshr.address);
+  }
+
+  auto way = std::find_if_not(set_begin, set_end, [](const auto& x) { return x.valid; });
+  if (way == set_end) {
+    if (unified) {
+      const auto set_idx = get_unified_huge_span_index(fill_mshr.address);
+      way = std::next(set_begin, impl_find_victim(fill_mshr.cpu, fill_mshr.instr_id, set_idx, &*set_begin, fill_mshr.ip, fill_mshr.address, fill_mshr.type));
+    } else {
+      /* plain LRU over the separate array */
+      way = std::min_element(set_begin, set_end, [](const auto& lhs, const auto& rhs) { return lhs.pf_metadata < rhs.pf_metadata; });
+    }
+  }
+
+  *way = champsim::cache_block{};
+  way->valid = true;
+  way->prefetch = fill_mshr.prefetch_from_this;
+  way->dirty = (fill_mshr.type == access_type::WRITE);
+  way->address = fill_mshr.address;
+  way->v_address = fill_mshr.v_address;
+  way->data = fill_mshr.data_promise->data;
+  way->page_shift = static_cast<uint8_t>(shift);
+  if (!unified) {
+    way->pf_metadata = ++huge_lru_clock;
+  }
+}
+
+long CACHE::get_unified_huge_span_index(champsim::address address) const
+{
+  return address.slice(champsim::dynamic_extent{HUGE_SHIFT, champsim::lg2(NUM_SET)}).to<long>();
+}
+
+auto CACHE::get_unified_huge_span(champsim::address address) -> std::pair<set_type::iterator, set_type::iterator>
+{
+  const auto set_idx = address.slice(champsim::dynamic_extent{HUGE_SHIFT, champsim::lg2(NUM_SET)}).to<long>();
+  assert(set_idx >= 0);
+  assert(set_idx < NUM_SET);
+  const auto begin = std::next(std::begin(block), set_idx * NUM_WAY);
+  return {begin, std::next(begin, NUM_WAY)};
+}
